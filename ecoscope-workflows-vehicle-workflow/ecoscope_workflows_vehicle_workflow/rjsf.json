    "time_range": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "format": "date-time",
          "title": "Since",
          "type": "string",
          "description": "The start time"
        },
        "until": {
          "format": "date-time",
          "title": "Until",
          "type": "string",
          "description": "The end time"
        },
        "timezone": {
          "allOf": [
            {
              "$ref": "#/$defs/TimezoneInfo"
            }
          ],
          "default": null,
          "title": "Timezone"
        }
      },
      "required": [
        "since",
        "until"
      ],
      "type": "object",
      "description": "Choose the period of time to analyze.",
      "title": "Time Range"
    },
    "patente": {
      "additionalProperties": false,
      "properties": {
        "var": {
          "title": "Patente",
          "type": "string"
        }
      },
      "required": [
        "var"
      ],
      "type": "object",
      "title": "Patente del Veh\u00edculo"
    },
    "events": {
      "additionalProperties": false,
      "properties": {
        "event_states": {
          "default": null,
          "items": {
            "type": "string",
            "oneOf": [
              {
                "const": "new",
                "title": "New"
              },
              {
                "const": "active",
                "title": "Active"
              },
              {
                "const": "resolved",
                "title": "Resolved"
              },
              {
                "const": "review",
                "title": "Review"
              }
            ]
          },
          "title": "Event State",
          "type": "array",
          "description": "Choose to analyze events with a certain state. If left empty, events of all states will be analyzed",
          "uniqueItems": true,
          "ecoscope:advanced": true
        },
        "force_point_geometry": {
          "default": true,
          "title": "Force Point Geometry",
          "type": "boolean",
          "description": "If True, polygon/multipolygon event geometries are reduced to their centroid. Set False to preserve native geometry types.",
          "ecoscope:advanced": true
        }
      },
      "required": [],
      "type": "object",
      "title": "Libro Diario Vehicular Events"
    },
    "KM Over Time Chart": {
      "type": "object",
      "description": "Monthly bar chart of kilometres travelled for the selected vehicle.",
      "ecoscope:task_group": true,
      "properties": {
        "km_over_time_chart": {
          "additionalProperties": false,
          "properties": {
            "color_palette": {
              "default": null,
              "items": {
                "type": "string"
              },
              "title": "Color Palette",
              "type": "array",
              "description": "Ordered hex color list. Cycles if more categories than colors."
            }
          },
          "required": [],
          "type": "object",
          "title": ""
        }
      }
    },
    "Driver Ranking Table": {
